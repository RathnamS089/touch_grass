{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Grounded",
  "version": "0.1.0",
  "identifier": "com.grounded.touchgrass",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Grounded",
        "width": 720,
        "height": 860,
        "minWidth": 560,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
