# Grounded environment configuration
# Copy this file to .env and fill in your Supabase project values.
# The Supabase URL and anon (publishable) key are safe for client apps —
# the anon key only grants INSERT on the notification_history table
# (see supabase/migrations/ for the schema and RLS policy).

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
